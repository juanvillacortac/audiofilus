per_frame_init_1=spin = 0;
per_frame_1=spin = spin + 0.002 + 0.01*(bass_att - 1)*above(bass_att, 1);
per_frame_2=rot = 0.02*sin(time*0.3 + spin) + 0.03*(bass_att - 1);
per_frame_3=zoom = 1.03 + 0.04*(bass - 1)*above(bass, 1);
per_frame_4=wave_r = 0.9 + 0.1*sin(time*1.3);
per_frame_5=wave_g = 0.35 + 0.2*sin(time*0.7 + treb_att);
per_frame_6=wave_b = 0.05 + 0.05*sin(time*0.5);
per_frame_7=wave_mystery = -0.2 + 0.15*(mid_att - 1);
per_frame_8=q1 = 0.5 + 0.5*sin(time*0.4);
per_pixel_1=rot = rot + 0.04*sin(rad*6 - time*2)*q1;
per_pixel_2=zoom = zoom + 0.02*rad;
