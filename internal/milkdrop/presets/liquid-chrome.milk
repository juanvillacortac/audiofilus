[preset00]
fRating=4.000000
fGammaAdj=1.400000
fDecay=0.985000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=1
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
bBrighten=0
bSolarize=0
fWaveAlpha=0.800000
fWaveScale=1.500000
fWarpAnimSpeed=1.400000
fWarpScale=2.000000
fShader=0.600000
zoom=1.000000
rot=0.000000
warp=1.600000
wave_r=0.800000
wave_g=0.850000
wave_b=0.900000
per_frame_1=q1 = 0.5 + 0.5*sin(time*0.25);
per_frame_2=solarize = above(bass_att, 1.35);
per_frame_3=warp = 1.2 + 0.8*(mid_att - 1);
per_frame_4=wave_x = 0.5 + 0.2*sin(time*0.41);
per_frame_5=wave_y = 0.5 + 0.2*cos(time*0.29);
per_pixel_1=zoom = 1.005 + 0.04*sin(rad*10 - time*3)*q1;
per_pixel_2=rot = 0.015*sin(ang*3 + time);
per_frame_6=wave_r = 0.5 + 0.5*sin(time*0.6);
per_frame_7=wave_g = 0.5 + 0.5*sin(time*0.6 + 2.1);
per_frame_8=wave_b = 0.5 + 0.5*sin(time*0.6 + 4.2);
