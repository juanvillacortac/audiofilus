[preset00]
fRating=4.000000
fGammaAdj=2.000000
fDecay=0.900000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=5
bAdditiveWaves=1
bWaveDots=1
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=0
bDarkenCenter=1
fWaveAlpha=0.800000
fWaveScale=1.000000
zoom=1.060000
rot=0.000000
warp=0.000000
wave_r=0.700000
wave_g=0.800000
wave_b=1.000000
wavecode_0_enabled=1
wavecode_0_samples=200
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_r=1.000000
wavecode_0_g=1.000000
wavecode_0_b=1.000000
wavecode_0_a=1.000000
wave_0_init1=i = 0; loop(400, megabuf(i) = rand(1000)/1000; i = i + 1);
wave_0_per_point1=n = int(sample*199);
wave_0_per_point2=x = 0.5 + (megabuf(n) - 0.5)*0.8;
wave_0_per_point3=y = 0.5 + (megabuf(n + 200) - 0.5)*0.8;
wave_0_per_point4=a = 0.15 + abs(value1)*3;
wave_0_per_point5=b = 0.7 + 0.3*megabuf(n);
per_frame_1=reg00 = reg00 + 0.004 + 0.01*bass_att;
per_frame_2=rot = 0.03*sin(reg00);
per_frame_3=zoom = 1.03 + 0.05*bass_att;
per_frame_4=wave_r = 0.6 + 0.4*sin(time*0.3);
per_frame_5=wave_g = 0.6 + 0.4*sin(time*0.37 + 1);
