per_frame_7=decay = 0.97 + 0.01*sin(time*0.2);
per_pixel_1=dx = 0.004*sin(y*9 + q1) + 0.002*sin(y*23 - q1*1.7);
per_pixel_2=dy = q2*(1.2 - y);
per_pixel_3=sx = 1 - 0.01*sin(x*3.14);
