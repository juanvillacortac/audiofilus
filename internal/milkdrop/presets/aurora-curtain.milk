wave_0_per_point4=b = 1 - sample;
per_frame_1=wave_mystery = 0.08*sin(time*0.37);
per_frame_2=wave_r = 0.2 + 0.2*sin(time*0.21);
per_frame_3=wave_g = 0.8 + 0.2*sin(time*0.33);
