fWaveScale=0.800000
fShader=0.300000
zoom=1.000000
warp=0.400000
wave_r=0.300000
wave_g=0.600000
wave_b=1.000000
wave_y=0.500000
shapecode_0_enabled=1
shapecode_0_sides=32
shapecode_0_additive=1
shapecode_0_thickOutline=1
shapecode_0_textured=0
shapecode_0_rad=0.050000
shapecode_0_r=0.000000
shapecode_0_g=0.000000
shapecode_0_b=0.000000
shapecode_0_a=0.000000
shapecode_0_a2=0.000000
shapecode_0_border_r=0.600000
shapecode_0_border_g=0.900000
shapecode_0_border_b=1.000000
shapecode_0_border_a=0.800000
shape_0_per_frame1=x = q2; y = q3;
shape_0_per_frame2=rad = 0.03 + q4*0.5;
shape_0_per_frame3=border_a = max(0, 0.9 - q4*1.2);
per_frame_init_1=last = -10; px = 0.5; py = 0.5;
per_frame_1=hit = above(bass, 1.4)*above(time, last + 0.5);
per_frame_2=last = if(hit, time, last);
per_frame_3=px = if(hit, 0.15 + rand(70)/100, px);
per_frame_4=py = if(hit, 0.2 + rand(60)/100, py);
per_frame_5=q1 = 0.5 + 0.5*sin(time*0.3);
per_frame_6=q2 = px; q3 = py; q4 = time - last;
per_frame_7=wave_y = 0.5 + 0.1*sin(time*0.17);
per_pixel_1=zoom = 1 + 0.025*sin(rad*20 - time*4)*(0.3 + q1);
per_pixel_2=rot = 0.006*cos(rad*8 + time);
